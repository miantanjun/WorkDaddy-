# 本机数据与构建产物，不入库
_backup/
scripts/runtime/
release/windows/
release/.cache/
# Go 网关：源码入库（vendor/wb2api-go），编译产物与依赖缓存不入库
vendor/wb2api-go/dist/
vendor/wb2api-go/.git/
# 网关运行期文件（可能含密钥/凭证），绝不入库
vendor/wb2api-go/config.json
vendor/wb2api-go/.env
vendor/wb2api-go/.env.*
vendor/wb2api-go/auths/
vendor/wb2api-go/data/
vendor/wb2api-go/backups/

# Inno 卸载器状态（含本机安装路径，机器专属，不能跨机同步）
unins000.*
卸载 WorkDaddy.*
卸载 WorkBuddy 助手.*

# 日志
*.log
daemon.log

# Node
node_modules/
npm-debug.log*

# macOS
.DS_Store

# 构建产物与安装包
WorkDaddy.app
/release/**/*.dmg
/release/**/*.exe
/release/**/*.zip
/release/**/*.pkg
/release/**/*.tar.gz
/release/**/*.deb

# 内部调试模块（元素检查/DevTools 实现，不公开入库；他人环境点按钮报错属预期）
scripts/picker-internal.js

# 工作区元数据（WorkBuddy 项目数据，不入库）
.workbuddy/
.workbuddy-ai/

# 本地维护文档与排查记录
/.private-docs/

# .wd-analysis 只入库脚本：真机截图与真实扫描结果是本机证据，可随时重生成
# （脚本：cdp-eval.py / probe-*.js / real-space-scan.js / rescan-and-report.py）
.wd-analysis/*.png
.wd-analysis/real-space-scan.json
# probe-*/test-*/verify-* 脚本的文本报告同为「本机证据」，不入库
.wd-analysis/*.out.txt
.wd-analysis/*.report.txt
# 测试沙箱：test-context-fix.js 用**硬编码绝对路径**当沙箱且跑完不清理（每跑一次回归就冒出来）
.wd-analysis/tmp-*/

# 向量路侦查用的模型权重与编码缓存（阶段 7）
# 114MB 模型 + 200MB+ 编码结果，纯本机生成物，脚本在库里可随时重建
# 规则：只入库 probe-*.py / probe-*.js 与 probe-*.json（结论），不入库权重
.wd-analysis/eval/.onnx-flat/
.wd-analysis/eval/.emb-cache/
.wd-analysis/eval/.vec-cache/

# 回归跑分的历史明细（每次 run-eval 落一份，纯产物，随时重生成）
.wd-analysis/eval/out/

# 维护过程的临时产物（一次性探针 / 补丁脚本 / 命令输出 / 改前备份）
# 这些是本机专属、可随时重生成的 scratch，禁止入库
.wd-tmp/

# codegraph 本地索引（本机生成，体积大，可随时重建：codegraph init）
.codegraph/

# 改前备份（本机专属，改坏了才回滚用；手工造的，不入库）
.wd-backup/

# dsh-ops worker 的运行期结果存储（lock / ref:// 分片；随时可删）
.dsh-ops/
